+async function getActiveWebviewMemoryMB() {
+  const webview = document.getElementById("view");
+  if (!webview) {
+    return { ok: false, reason: "webview-not-found" };
+  }
+
+  const canGetWebContentsId = typeof webview.getWebContentsId === "function";
